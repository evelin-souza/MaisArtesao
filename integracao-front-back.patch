+import { ref, onMounted } from 'vue'
+import Navbar from '@/components/Navbar.vue'
+import UserFormDialog from '@/components/UserFormDialog.vue'
+import { usuariosService } from '@/services/usuarios.service'
+import { useAuthStore } from '@/stores/auth.store'
+import { useNotificationStore } from '@/stores/notification.store'
+import { getErrorMessage } from '@/utils/http-error'
+import type { CriarUsuarioPayload, Usuario, UsuarioFormSubmit } from '@/types/usuario'
+
+const authStore = useAuthStore()
+const notification = useNotificationStore()
+
+const headers = [
+  { title: 'Nome', key: 'nome' },
+  { title: 'E-mail', key: 'email' },
+  { title: 'Telefone', key: 'telefone' },
+  { title: 'Tipo de Perfil', key: 'tipo_usuario' },
+  { title: 'Status', key: 'ativo' },
+  { title: 'Ações', key: 'acoes', sortable: false }
+]
+
+const usuarios = ref<Usuario[]>([])
+const loading = ref(false)
+const errorMessage = ref('')
+
+const dialog = ref(false)
+const usuarioSelecionado = ref<Usuario | null>(null)
+const salvando = ref(false)
+
+const usuarioParaDesativar = ref<Usuario | null>(null)
+const desativando = ref(false)
+
+const carregarUsuarios = async () => {
+  try {
+    loading.value = true
+    errorMessage.value = ''
+    usuarios.value = await usuariosService.listar()
+  } catch (error) {
+    errorMessage.value = getErrorMessage(error, 'Não foi possível carregar os usuários.')
+  } finally {
+    loading.value = false
+  }
+}
+
+onMounted(carregarUsuarios)
+
+const ehUsuarioLogado = (usuario: Usuario) => usuario.id_usuario === authStore.user?.id
+
+const abrirModalCadastro = () => {
+  usuarioSelecionado.value = null
+  dialog.value = true
+}
+
+const abrirModalEdicao = (usuario: Usuario) => {
+  usuarioSelecionado.value = { ...usuario }
+  dialog.value = true
+}
+
+const substituirNaLista = (atualizado: Usuario) => {
+  usuarios.value = usuarios.value.map((u) =>
+    u.id_usuario === atualizado.id_usuario ? atualizado : u,
+  )
+}
+
+const salvarUsuario = async ({ id, payload }: UsuarioFormSubmit) => {
+  try {
+    salvando.value = true
+
+    if (id) {
+      substituirNaLista(await usuariosService.atualizar(id, payload))
+      notification.success('Usuário atualizado com sucesso.')
+    } else {
+      const criado = await usuariosService.criar(payload as CriarUsuarioPayload)
+      usuarios.value = [...usuarios.value, criado]
+      notification.success('Usuário cadastrado com sucesso.')
+    }
+
+    dialog.value = false
+  } catch (error) {
+    notification.error(getErrorMessage(error, 'Não foi possível salvar o usuário.'))
+  } finally {
+    salvando.value = false
+  }
+}
+
+const confirmarDesativacao = async () => {
+  if (!usuarioParaDesativar.value) return
+
+  try {
+    desativando.value = true
+    substituirNaLista(await usuariosService.desativar(usuarioParaDesativar.value.id_usuario))
+    notification.success('Usuário desativado com sucesso.')
+    usuarioParaDesativar.value = null
+  } catch (error) {
+    notification.error(getErrorMessage(error, 'Não foi possível desativar o usuário.'))
+  } finally {
+    desativando.value = false
+  }
+}
+
+const getChipColor = (tipo: string) => {
+  if (tipo === 'ADMIN') return 'error'
+  if (tipo === 'ARTESAO') return 'warning'
+  return 'info'
+}
+</script>
