+import { defineStore } from 'pinia'
+import { authService } from '@/services/auth.service'
+import { usuariosService } from '@/services/usuarios.service'
+import { decodeJwt, isTokenExpired } from '@/utils/jwt'
+import type { TipoUsuario } from '@/types/usuario'
+
+export interface User {
+  id: number
+  email: string
+  nome: string
+  tipo: TipoUsuario
+}
+
+/** Rota inicial de cada perfil */
+export function rotaPorTipo(tipo?: TipoUsuario | null): string {
+  if (tipo === 'ADMIN') return '/admin'
+  if (tipo === 'ARTESAO') return '/artesao'
+  if (tipo === 'CLIENTE') return '/vitrine'
+  return '/login'
+}
+
+function lerUsuarioSalvo(): User | null {
+  try {
+    return JSON.parse(localStorage.getItem('user') || 'null') as User | null
+  } catch {
+    return null
+  }
+}
+
+function lerTokenSalvo(): string {
+  const token = localStorage.getItem('token') || ''
+  // Token expirado (o backend emite com validade de 1h): descarta a sessão
+  if (token && isTokenExpired(token)) {
+    localStorage.removeItem('token')
+    localStorage.removeItem('user')
+    return ''
+  }
+  return token
+}
+
+export const useAuthStore = defineStore('auth', {
+  state: () => {
+    const token = lerTokenSalvo()
+    return {
+      user: (token ? lerUsuarioSalvo() : null) as User | null,
+      token,
+    }
+  },
+  getters: {
+    isAuthenticated: (state) => !!state.token && !isTokenExpired(state.token),
+  },
+  actions: {
+    /**
+     * O backend responde ao login apenas com { access_token }.
+     * O id e o perfil vêm no payload do JWT; o nome é buscado em GET /usuarios/:id.
+     */
+    async login(email: string, senha: string) {
+      const { access_token } = await authService.login(email, senha)
+
+      const payload = decodeJwt(access_token)
+      if (!payload) {
+        throw new Error('Resposta de login inválida.')
+      }
+
+      // O interceptor do Axios lê o token do localStorage
+      localStorage.setItem('token', access_token)
+
+      let nome = payload.email
+      try {
+        const usuario = await usuariosService.buscarPorId(payload.sub)
+        nome = usuario.nome
+      } catch {
+        // Falha ao buscar o perfil não deve impedir o login; usa o e-mail como nome de exibição
+      }
+
+      this.token = access_token
+      this.user = {
+        id: payload.sub,
+        email: payload.email,
+        nome,
+        tipo: payload.tipo_usuario,
+      }
+      localStorage.setItem('user', JSON.stringify(this.user))
+    },
+    logout() {
+      this.token = ''
+      this.user = null
+      localStorage.removeItem('token')
+      localStorage.removeItem('user')
+    },
+  },
+})
