+import { defineStore } from 'pinia'
+
+type Cor = 'success' | 'error' | 'info'
+
+/** Mensagens de sucesso/erro exibidas em um único snackbar global (ver App.vue). */
+export const useNotificationStore = defineStore('notification', {
+  state: () => ({
+    show: false,
+    message: '',
+    color: 'success' as Cor,
+  }),
+  actions: {
+    notify(message: string, color: Cor) {
+      this.message = message
+      this.color = color
+      this.show = true
+    },
+    success(message: string) {
+      this.notify(message, 'success')
+    },
+    error(message: string) {
+      this.notify(message, 'error')
+    },
+    info(message: string) {
+      this.notify(message, 'info')
+    },
+  },
+})
