+// Tipos que espelham os DTOs e as respostas do backend (src/usuarios).
+
+export type TipoUsuario = 'ADMIN' | 'ARTESAO' | 'CLIENTE'
+
+export const TIPOS_USUARIO: readonly TipoUsuario[] = ['ADMIN', 'ARTESAO', 'CLIENTE']
+
+/** Resposta do backend (UsuariosService.removerSenha) */
+export interface Usuario {
+  id_usuario: number
+  nome: string
+  email: string
+  telefone: string
+  tipo_usuario: TipoUsuario
+  ativo: boolean
+  data_cadastro: string
+}
+
+/** CriarUsuarioDto */
+export interface CriarUsuarioPayload {
+  nome: string
+  email: string
+  senha: string
+  telefone: string
+  tipo_usuario: TipoUsuario
+}
+
+/** AtualizarUsuarioDto (todos opcionais; `ativo` é ignorado pelo service, por isso não é enviado) */
+export type AtualizarUsuarioPayload = Partial<CriarUsuarioPayload>
+
+/** Evento emitido pelo UserFormDialog: id nulo = cadastro; id preenchido = edição */
+export interface UsuarioFormSubmit {
+  id: number | null
+  payload: CriarUsuarioPayload | AtualizarUsuarioPayload
+}
