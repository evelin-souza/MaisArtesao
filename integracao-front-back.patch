index 0000000..5a203bd
--- /dev/null
+++ b/frontend/src/components/UserFormDialog.vue
@@ -0,0 +1,149 @@
+<template>
+  <v-dialog :model-value="modelValue" @update:model-value="$emit('update:modelValue', $event)" max-width="600px">
+    <v-card rounded="lg" class="pa-2">
+      <v-card-title class="text-h6 font-weight-bold">
+        {{ isEdit ? 'Editar Usuário' : 'Cadastrar Novo Usuário' }}
+      </v-card-title>
+
+      <v-card-text>
+        <v-form ref="formRef" @submit.prevent="handleSubmit">
+          <v-text-field
+            v-model="formData.nome"
+            label="Nome"
+            variant="outlined"
+            :rules="[obrigatorio]"
+          />
+          <v-text-field
+            v-model="formData.email"
+            label="E-mail"
+            type="email"
+            variant="outlined"
+            :rules="[obrigatorio, emailValido]"
+          />
+          <v-text-field
+            v-model="formData.telefone"
+            label="Telefone"
+            variant="outlined"
+            :rules="[obrigatorio]"
+          />
+          <v-select
+            v-model="formData.tipo_usuario"
+            :items="TIPOS_USUARIO"
+            label="Tipo de Perfil"
+            variant="outlined"
+            :disabled="bloquearTipo"
+            :hint="bloquearTipo ? 'Você não pode alterar o seu próprio perfil.' : undefined"
+            :persistent-hint="bloquearTipo"
+            :rules="[obrigatorio]"
+          />
+          <v-text-field
+            v-model="formData.senha"
+            :label="isEdit ? 'Nova senha (deixe em branco para manter)' : 'Senha'"
+            type="password"
+            variant="outlined"
+            autocomplete="new-password"
+            :rules="[senhaValida]"
+          />
+
+          <div class="d-flex justify-end gap-2 mt-4">
+            <v-btn variant="text" @click="$emit('update:modelValue', false)">Cancelar</v-btn>
+            <v-btn type="submit" color="success" :loading="loading">
+              {{ isEdit ? 'Salvar Alterações' : 'Cadastrar' }}
+            </v-btn>
+          </div>
+        </v-form>
+      </v-card-text>
+    </v-card>
+  </v-dialog>
+</template>
+
+<script setup lang="ts">
+import { reactive, ref, watch } from 'vue'
+import {
+  TIPOS_USUARIO,
+  type AtualizarUsuarioPayload,
+  type CriarUsuarioPayload,
+  type TipoUsuario,
+  type Usuario,
+  type UsuarioFormSubmit,
+} from '@/types/usuario'
+
+interface Props {
+  modelValue: boolean
+  initialData?: Usuario | null
+  loading?: boolean
+  bloquearTipo?: boolean
+}
+
+const props = defineProps<Props>()
+const emit = defineEmits<{
+  (e: 'update:modelValue', value: boolean): void
+  (e: 'save', value: UsuarioFormSubmit): void
+}>()
+
+const formRef = ref<{ validate: () => Promise<{ valid: boolean }> } | null>(null)
+const isEdit = ref(false)
+
+const formData = reactive({
+  nome: '',
+  email: '',
+  telefone: '',
+  tipo_usuario: 'CLIENTE' as TipoUsuario,
+  senha: '',
+})
+
+// Preenche o formulário toda vez que o diálogo é aberto
+watch(
+  () => props.modelValue,
+  (aberto) => {
+    if (!aberto) return
+    if (props.initialData) {
+      isEdit.value = true
+      formData.nome = props.initialData.nome
+      formData.email = props.initialData.email
+      formData.telefone = props.initialData.telefone
+      formData.tipo_usuario = props.initialData.tipo_usuario
+      formData.senha = ''
+    } else {
+      isEdit.value = false
+      formData.nome = ''
+      formData.email = ''
+      formData.telefone = ''
+      formData.tipo_usuario = 'CLIENTE'
+      formData.senha = ''
+    }
+  },
+  { immediate: true },
+)
+
+// Regras alinhadas aos DTOs do backend (CriarUsuarioDto / AtualizarUsuarioDto)
+const obrigatorio = (v: string) => !!(v && v.trim()) || 'Campo obrigatório'
+const emailValido = (v: string) => /^\S+@\S+\.\S+$/.test(v) || 'E-mail inválido'
+const senhaValida = (v: string) => {
+  if (isEdit.value && !v) return true // na edição a senha é opcional
+  if (!v) return 'Campo obrigatório'
+  return v.length >= 6 || 'A senha deve ter pelo menos 6 caracteres'
+}
+
+const handleSubmit = async () => {
+  const resultado = await formRef.value?.validate()
+  if (!resultado?.valid) return
+
+  // Envia somente os campos aceitos pelos DTOs (o backend rejeita campos extras)
+  const base = {
+    nome: formData.nome.trim(),
+    email: formData.email.trim(),
+    telefone: formData.telefone.trim(),
+    tipo_usuario: formData.tipo_usuario,
+  }
+
+  if (isEdit.value && props.initialData) {
+    const payload: AtualizarUsuarioPayload = { ...base }
+    if (formData.senha) payload.senha = formData.senha
+    emit('save', { id: props.initialData.id_usuario, payload })
+  } else {
+    const payload: CriarUsuarioPayload = { ...base, senha: formData.senha }
+    emit('save', { id: null, payload })
+  }
+}
+</script>
