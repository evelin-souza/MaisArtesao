+
+export const usuariosService = {
+  /** GET /usuarios  (ADMIN) */
+  async listar(): Promise<Usuario[]> {
+    const { data } = await api.get<Usuario[]>('/usuarios')
+    return data
+  },
+
+  /** GET /usuarios/:id  (qualquer usuário autenticado) */
+  async buscarPorId(id: number): Promise<Usuario> {
+    const { data } = await api.get<Usuario>(`/usuarios/${id}`)
+    return data
+  },
+
+  /** POST /usuarios  (público) */
+  async criar(payload: CriarUsuarioPayload): Promise<Usuario> {
+    const { data } = await api.post<Usuario>('/usuarios', payload)
+    return data
+  },
+
+  /** PATCH /usuarios/:id  (ADMIN) */
+  async atualizar(id: number, payload: AtualizarUsuarioPayload): Promise<Usuario> {
+    const { data } = await api.patch<Usuario>(`/usuarios/${id}`, payload)
+    return data
+  },
+
+  /** PATCH /usuarios/:id/desativar  (ADMIN) — o backend não possui DELETE */
+  async desativar(id: number): Promise<Usuario> {
+    const { data } = await api.patch<Usuario>(`/usuarios/${id}/desativar`)
+    return data
+  },
+}
